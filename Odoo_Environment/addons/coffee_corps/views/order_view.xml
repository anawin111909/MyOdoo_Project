<odoo>
    <!-- Order List View -->
    <record id="view_coffee_order_list" model="ir.ui.view">
        <field name="name">coffee.shop.order.list</field>
        <field name="model">coffee.shop.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="order_date"/>
                <field name="employee_id"/>
                <field name="total_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Order Form View -->
    <record id="view_coffee_order_form" model="ir.ui.view">
        <field name="name">coffee.shop.order.form</field>
        <field name="model">coffee.shop.order</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Order Information">
                            <field name="name"/>
                            <field name="order_date"/>
                            <field name="employee_id"/>
                            <field name="state"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <group>
                        <group>
                            <field name="total_amount"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Order Action -->
    <record id="action_coffee_order"
            model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">coffee.shop.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
