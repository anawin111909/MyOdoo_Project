<odoo>
    <!-- Product List View -->
    <record id="view_coffee_product_list" model="ir.ui.view">
        <field name="name">coffee.shop.product.list</field>
        <field name="model">coffee.shop.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category"/>
                <field name="price"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Product Form View -->
    <record id="view_coffee_product_form" model="ir.ui.view">
        <field name="name">coffee.shop.product.form</field>
        <field name="model">coffee.shop.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="price"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Product Action -->
    <record id="action_coffee_product" model="ir.actions.act_window">
        <field name="name">Coffee Products</field>
        <field name="res_model">coffee.shop.product</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
