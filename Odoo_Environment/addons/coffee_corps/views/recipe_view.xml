<odoo>
    <record id="view_coffee_recipe_line_list" model="ir.ui.view">
        <field name="name">coffee.shop.recipe.line.list</field>
        <field name="model">coffee.shop.recipe.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id"/>
                <field name="ingredient_id"/>
                <field name="quantity"/>
            </list>
        </field>
    </record>

    <record id="view_coffee_recipe_line_form" model="ir.ui.view">
        <field name="name">coffee.shop.recipe.line.form</field>
        <field name="model">coffee.shop.recipe.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="ingredient_id"/>
                        <field name="quantity"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_coffee_recipe_line" model="ir.actions.act_window">
        <field name="name">Product Recipes</field>
        <field name="res_model">coffee.shop.recipe.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>